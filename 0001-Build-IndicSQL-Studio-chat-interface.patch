index 0000000..ef0ca90
--- /dev/null
+++ b/frontend/src/lib/api-client.ts
@@ -0,0 +1,92 @@
+import {
+  BackendHealthResponse,
+  QueryResponse,
+  SchemasResponse,
+  VoiceSynthesizeRequest,
+  VoiceSynthesizeResponse,
+  VoiceTranscribeResponse,
+} from "@/types/api";
+
+const API_BASE_URL = (
+  process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:8000"
+).replace(/\/+$/, "");
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number
+  ) {
+    super(message);
+    this.name = "ApiError";
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${API_BASE_URL}${path}`, init);
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "AbortError") {
+      throw error;
+    }
+    throw new ApiError(
+      `Could not connect to the IndicSQL backend at ${API_BASE_URL}.`,
+      0
+    );
+  }
+
+  if (!response.ok) {
+    let message = `Backend request failed (${response.status}).`;
+    try {
+      const body = (await response.json()) as { detail?: unknown };
+      if (typeof body.detail === "string") {
+        message = body.detail;
+      } else if (body.detail !== undefined) {
+        message = JSON.stringify(body.detail);
+      }
+    } catch {
+      // Keep the HTTP status message when the backend returns a non-JSON error.
+    }
+    throw new ApiError(message, response.status);
+  }
+
+  return (await response.json()) as T;
+}
+
+export const apiClient = {
+  checkHealth(): Promise<BackendHealthResponse> {
+    return request<BackendHealthResponse>("/health");
+  },
+
+  fetchSchemas(): Promise<SchemasResponse> {
+    return request<SchemasResponse>("/schemas");
+  },
+
+  submitQuery(query: string, signal?: AbortSignal): Promise<QueryResponse> {
+    return request<QueryResponse>("/query", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ query }),
+      signal,
+    });
+  },
+
+  transcribeAudio(audio: Blob): Promise<VoiceTranscribeResponse> {
+    const formData = new FormData();
+    formData.append("file", audio, "recording.wav");
+    return request<VoiceTranscribeResponse>("/voice/transcribe", {
+      method: "POST",
+      body: formData,
+    });
+  },
+
+  synthesizeSpeech(
+    payload: VoiceSynthesizeRequest
+  ): Promise<VoiceSynthesizeResponse> {
+    return request<VoiceSynthesizeResponse>("/voice/synthesize", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+  },
+};
diff --git a/frontend/src/lib/chart-utils.ts b/frontend/src/lib/chart-utils.ts
new file mode 100644
index 0000000..2dc18f9
--- /dev/null
+++ b/frontend/src/lib/chart-utils.ts
@@ -0,0 +1,52 @@
+type ChartDatum = Record<string, string | number | boolean | null>;
+
+export type ChartInfo =
+  | { chartType: "none" }
+  | { chartType: "kpi"; kpiLabel: string; kpiValue: string | number | boolean | null }
+  | {
+      chartType: "bar" | "line";
+      categoryKey: string;
+      dataKey: string;
+      data: ChartDatum[];
+    };
+
+export function detectChartType(
+  columns: string[],
+  rows: (string | number | boolean | null)[][]
+): ChartInfo {
+  if (columns.length === 1 && rows.length === 1) {
+    return {
+      chartType: "kpi",
+      kpiLabel: columns[0],
+      kpiValue: rows[0][0],
+    };
+  }
+
+  if (columns.length < 2 || rows.length === 0) return { chartType: "none" };
+
+  const numericColumnIndex = columns.findIndex((_, index) =>
+    rows.some((row) => typeof row[index] === "number")
+  );
+  if (numericColumnIndex < 0) return { chartType: "none" };
+
+  const categoryColumnIndex = columns.findIndex(
+    (_, index) => index !== numericColumnIndex
+  );
+  const categoryKey = columns[categoryColumnIndex];
+  const dataKey = columns[numericColumnIndex];
+  const data = rows.map((row) => {
+    const datum: ChartDatum = {};
+    columns.forEach((column, index) => {
+      datum[column] = row[index];
+    });
+    return datum;
+  });
+  const isTemporal = /date|year|month|time|quarter/i.test(categoryKey);
+
+  return {
+    chartType: isTemporal ? "line" : "bar",
+    categoryKey,
+    dataKey,
+    data,
+  };
+}
diff --git a/frontend/src/lib/csv-export.ts b/frontend/src/lib/csv-export.ts
new file mode 100644
index 0000000..368688a
--- /dev/null
+++ b/frontend/src/lib/csv-export.ts
@@ -0,0 +1,22 @@
+function escapeCSVCell(value: string | number | boolean | null): string {
+  if (value === null || value === undefined) return "";
+  const text = String(value);
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+export function exportToCSV(
+  columns: string[],
+  rows: (string | number | boolean | null)[][],
+  filename: string
+): void {
+  const csv = [columns, ...rows]
+    .map((row) => row.map(escapeCSVCell).join(","))
+    .join("\r\n");
+  const blob = new Blob(["\uFEFF", csv], { type: "text/csv;charset=utf-8" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+}
