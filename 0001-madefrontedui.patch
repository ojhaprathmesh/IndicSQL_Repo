+++ b/frontend/app/src/App.css
@@ -0,0 +1,310 @@
+.app-shell {
+  max-width: 1180px;
+  margin: 0 auto;
+  padding: 30px 24px 24px;
+}
+
+.topbar,
+.brand,
+.section-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.topbar {
+  margin-bottom: 30px;
+  gap: 20px;
+}
+
+.brand {
+  justify-content: flex-start;
+  gap: 13px;
+}
+
+.brand-mark {
+  display: grid;
+  width: 44px;
+  height: 44px;
+  place-items: center;
+  border-radius: 14px;
+  background: #e7f0e9;
+  color: #42604c;
+  font-family: Georgia, serif;
+  font-size: 1.4rem;
+  font-weight: 700;
+}
+
+.eyebrow {
+  margin: 0 0 4px;
+  color: #718174;
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+
+.topbar h1 {
+  margin: 0;
+  color: #28352d;
+  font-family: Georgia, 'Times New Roman', serif;
+  font-size: 1.8rem;
+  font-weight: 600;
+  letter-spacing: -0.035em;
+}
+
+.dashboard {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 18px;
+}
+
+.panel {
+  padding: 23px;
+  border: 1px solid #e6e9e3;
+  border-radius: 15px;
+  background: rgba(255, 255, 252, 0.92);
+  box-shadow: 0 4px 16px rgba(49, 63, 49, 0.035);
+}
+
+.panel h2 {
+  margin: 0;
+  color: #2f3b32;
+  font-family: Georgia, 'Times New Roman', serif;
+  font-size: 1.27rem;
+  font-weight: 600;
+}
+
+.muted,
+.empty-state {
+  color: #7c857d;
+  font-size: 0.9rem;
+}
+
+.muted {
+  margin: 7px 0 0;
+}
+
+textarea,
+button {
+  font: inherit;
+}
+
+textarea {
+  width: 100%;
+  border: 1px solid #dfe4dc;
+  border-radius: 10px;
+  background: #fff;
+  color: #303a32;
+  outline: none;
+  transition: border-color 0.15s ease, box-shadow 0.15s ease;
+}
+
+textarea {
+  min-height: 126px;
+  padding: 14px 15px;
+  resize: vertical;
+  line-height: 1.55;
+}
+
+textarea:focus {
+  border-color: #9eae9d;
+  box-shadow: 0 0 0 3px rgba(125, 151, 127, 0.13);
+}
+
+.section-heading {
+  margin-bottom: 17px;
+  gap: 14px;
+}
+
+.query-panel > .section-heading {
+  align-items: flex-end;
+}
+
+.new-question {
+  padding: 8px 12px;
+  border: 1px solid #dfe5dc;
+  border-radius: 8px;
+  background: #fff;
+  color: #536e59;
+  cursor: pointer;
+  font-size: 0.82rem;
+  font-weight: 650;
+}
+
+.new-question:hover {
+  background: #f5f7f2;
+}
+
+.language-picker {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin: 0 0 14px;
+}
+
+.language-chip {
+  padding: 7px 11px;
+  border: 1px solid #e2e7df;
+  border-radius: 999px;
+  background: #f8f9f5;
+  color: #657268;
+  font-size: 0.78rem;
+  transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.language-chip:hover {
+  border-color: #bdcbbd;
+  background: #f0f4ee;
+}
+
+.language-chip.selected {
+  border-color: #879d88;
+  background: #eaf0e8;
+  color: #405d45;
+  font-weight: 700;
+}
+
+.primary {
+  margin-top: 17px;
+  padding: 11px 20px;
+  border: 1px solid #536e59;
+  border-radius: 9px;
+  background: #536e59;
+  color: #fff;
+  cursor: pointer;
+  font-size: 0.9rem;
+  font-weight: 650;
+  transition: background 0.15s ease, transform 0.15s ease;
+}
+
+.primary:hover:not(:disabled) {
+  transform: translateY(-1px);
+  background: #435d49;
+}
+
+.primary:disabled {
+  cursor: not-allowed;
+  opacity: 0.58;
+}
+
+.results-heading {
+  margin-bottom: 18px;
+}
+
+.answer-summary {
+  margin-bottom: 18px;
+  padding: 15px 16px;
+  border: 1px solid #e6ebe2;
+  border-radius: 10px;
+  background: #f8faf6;
+}
+
+.answer-summary p:not(.eyebrow) {
+  margin: 0;
+  color: #465348;
+  font-size: 0.92rem;
+}
+
+.answer-summary .eyebrow {
+  margin: 0 0 5px;
+}
+
+.answer-divider {
+  height: 1px;
+  margin: 12px 0;
+  background: #e5e9e1;
+}
+
+.result-count {
+  padding: 6px 10px;
+  border-radius: 999px;
+  background: #edf3ec;
+  color: #516c56;
+  font-size: 0.8rem;
+  font-weight: 650;
+}
+
+.table-wrap {
+  overflow: auto;
+  border: 1px solid #e7eae4;
+  border-radius: 10px;
+}
+
+table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: left;
+}
+
+th,
+td {
+  padding: 12px 14px;
+  border-bottom: 1px solid #edf0ea;
+  color: #48534a;
+  font-size: 0.87rem;
+  white-space: nowrap;
+}
+
+th {
+  background: #f5f7f2;
+  color: #687568;
+  font-size: 0.75rem;
+  font-weight: 700;
+  text-transform: capitalize;
+}
+
+tbody tr:last-child td {
+  border-bottom: 0;
+}
+
+tbody tr:hover {
+  background: #fafbf8;
+}
+
+.empty-state {
+  margin: 0;
+  padding: 28px 12px;
+  text-align: center;
+}
+
+.message {
+  margin-bottom: 14px;
+  padding: 11px 13px;
+  border: 1px solid #edd3ce;
+  border-radius: 9px;
+  background: #fff7f5;
+  color: #984f43;
+  font-size: 0.88rem;
+}
+
+footer {
+  padding: 22px 4px 0;
+  color: #89928a;
+  font-size: 0.78rem;
+  text-align: center;
+}
+
+@media (max-width: 640px) {
+  .app-shell {
+    padding: 20px 14px;
+  }
+
+  .topbar {
+    align-items: flex-start;
+  }
+
+  .topbar h1 {
+    font-size: 1.5rem;
+  }
+
+  .panel {
+    padding: 18px;
+  }
+
+  .query-panel > .section-heading {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+}
diff --git a/frontend/app/src/App.jsx b/frontend/app/src/App.jsx
new file mode 100644
index 0000000..45550f7
--- /dev/null
+++ b/frontend/app/src/App.jsx
@@ -0,0 +1,206 @@
+import { useRef, useState } from 'react'
+import './App.css'
+
+const API_BASE_URL = 'http://localhost:8000'
+const languageExamples = {
+  English: 'Show PM-KISAN beneficiaries by state',
+  Hindi: 'राज्य के अनुसार पीएम-किसान लाभार्थियों की संख्या दिखाएं',
+  Bengali: 'রাজ্য অনুযায়ী পিএম-কিষাণ সুবিধাভোগীর সংখ্যা দেখান',
+  Tamil: 'மாநில வாரியாக பிஎம் கிசான் பயனாளர்களின் எண்ணிக்கையைக் காட்டுங்கள்',
+  Telugu: 'రాష్ట్రాల వారీగా పీఎం కిసాన్ లబ్ధిదారుల సంఖ్యను చూపించండి',
+  Marathi: 'राज्यानुसार पीएम-किसान लाभार्थ्यांची संख्या दाखवा',
+  Hinglish: 'State ke hisaab se PM-KISAN beneficiaries dikhao',
+}
+const localizedAnswers = {
+  English: (count) => `Found ${count} ${count === 1 ? 'record' : 'records'}. See the table below for the data.`,
+  Hindi: (count) => `${count} रिकॉर्ड मिले। डेटा के लिए नीचे दी गई तालिका देखें।`,
+  Bengali: (count) => `${count}টি রেকর্ড পাওয়া গেছে। তথ্যের জন্য নিচের সারণি দেখুন।`,
+  Tamil: (count) => `${count} பதிவுகள் கிடைத்தன. தரவைக் காண கீழே உள்ள அட்டவணையைப் பார்க்கவும்.`,
+  Telugu: (count) => `${count} రికార్డులు లభించాయి. డేటా కోసం దిగువ పట్టికను చూడండి.`,
+  Marathi: (count) => `${count} नोंदी मिळाल्या. डेटासाठी खालील तक्ता पहा.`,
+  Hinglish: (count) => `${count} records mile. Data ke liye neeche table dekhein.`,
+}
+const languageByCode = {
+  en: 'English',
+  hi: 'Hindi',
+  bn: 'Bengali',
+  ta: 'Tamil',
+  te: 'Telugu',
+  mr: 'Marathi',
+  'hi-en': 'Hinglish',
+}
+
+function App() {
+  const [selectedLanguage, setSelectedLanguage] = useState('English')
+  const [query, setQuery] = useState(languageExamples.English)
+  const [result, setResult] = useState(null)
+  const [loading, setLoading] = useState(false)
+  const [error, setError] = useState('')
+  const queryInput = useRef(null)
+
+  const fetchJson = async (url, options = {}) => {
+    const response = await fetch(url, {
+      ...options,
+      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
+    })
+    const data = await response.json().catch(() => ({}))
+
+    if (!response.ok) {
+      throw new Error(data.detail || data.error || 'Request failed')
+    }
+
+    return data
+  }
+
+  const handleRunQuery = async () => {
+    if (!query.trim()) {
+      setError('Enter a question to search the data.')
+      return
+    }
+
+    setLoading(true)
+    setError('')
+    setResult(null)
+    try {
+      const data = await fetchJson(`${API_BASE_URL}/query`, {
+        method: 'POST',
+        body: JSON.stringify({ query }),
+      })
+      if (languageByCode[data.detected_language]) {
+        setSelectedLanguage(languageByCode[data.detected_language])
+      }
+      setResult(data.execution_result || { columns: [], rows: [], row_count: 0 })
+    } catch (err) {
+      setError(err.message)
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  const columns = result?.columns || []
+  const rows = result?.rows || []
+  const resultCount = result?.row_count ?? rows.length
+
+  const handleNewQuestion = () => {
+    setQuery('')
+    setResult(null)
+    setError('')
+    queryInput.current?.focus()
+  }
+
+  return (
+    <div className="app-shell">
+      <header className="topbar">
+        <div className="brand">
+          <span className="brand-mark" aria-hidden="true">B</span>
+          <div>
+            <p className="eyebrow">IndicSQL data explorer</p>
+            <h1>BharatQuery</h1>
+          </div>
+        </div>
+      </header>
+
+      <main className="dashboard">
+        <section className="panel query-panel">
+          <div className="section-heading">
+            <div>
+              <p className="eyebrow">Search public data</p>
+              <h2>What would you like to find?</h2>
+            </div>
+            {result ? (
+              <button type="button" className="new-question" onClick={handleNewQuestion}>
+                New question
+              </button>
+            ) : null}
+          </div>
+          <div className="language-picker" aria-label="Choose a query language">
+            {Object.keys(languageExamples).map((language) => (
+              <button
+                key={language}
+                type="button"
+                className={`language-chip${selectedLanguage === language ? ' selected' : ''}`}
+                aria-pressed={selectedLanguage === language}
+                onClick={() => {
+                  setSelectedLanguage(language)
+                  setQuery(languageExamples[language])
+                }}
+              >
+                {language}
+              </button>
+            ))}
+          </div>
+          <textarea
+            ref={queryInput}
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            rows={4}
+            placeholder="Type a new question about the available datasets…"
+            aria-label={`Question in ${selectedLanguage}`}
+          />
+          <button
+            type="button"
+            className="primary"
+            onClick={handleRunQuery}
+            disabled={loading}
+          >
+            {loading ? 'Searching data…' : 'Search data'}
+          </button>
+        </section>
+
+        <section className="panel results-panel" aria-live="polite">
+          <div className="section-heading results-heading">
+            <div>
+              <p className="eyebrow">Results</p>
+              <h2>Fetched data</h2>
+            </div>
+            {result ? (
+              <span className="result-count">
+                {resultCount} {resultCount === 1 ? 'record' : 'records'}
+              </span>
+            ) : null}
+          </div>
+
+          {error ? <div className="message error">{error}</div> : null}
+
+          {result ? (
+            <div className="answer-summary">
+              <p className="eyebrow">Answer · {selectedLanguage}</p>
+              <p>{localizedAnswers[selectedLanguage](resultCount)}</p>
+              <div className="answer-divider" />
+              <p className="eyebrow">English</p>
+              <p>{localizedAnswers.English(resultCount)}</p>
+            </div>
+          ) : null}
+
+          {result && columns.length > 0 && rows.length > 0 ? (
+            <div className="table-wrap">
+              <table>
+                <thead>
+                  <tr>{columns.map((column) => <th key={column}>{column.replaceAll('_', ' ')}</th>)}</tr>
+                </thead>
+                <tbody>
+                  {rows.map((row, rowIndex) => (
+                    <tr key={rowIndex}>
+                      {columns.map((column, columnIndex) => (
+                        <td key={`${column}-${columnIndex}`}>
+                          {row[columnIndex] == null ? '—' : String(row[columnIndex])}
+                        </td>
+                      ))}
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          ) : result ? (
+            <p className="empty-state">No matching records were returned. Try a different question.</p>
+          ) : (
+            <p className="empty-state">Your fetched records will appear here.</p>
+          )}
+        </section>
+      </main>
+      <footer>IndicSQL · Government data, made easier to explore</footer>
+    </div>
+  )
+}
+
+export default App
