# ==============================================================================
# IndicSQL Configuration Environment Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Providers & Model Endpoints
# Primary: Sarvam AI / Sovereign Indic Model / Local vLLM
SARVAM_API_KEY=
SARVAM_MODEL_ENDPOINT=https://api.sarvam.ai/v1

# Secondary / Fallback: vLLM or OpenAI-compatible server for Qwen2.5-Coder
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=

# Embedding Model (mE5-large / BGE-M3)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ndap_schema_elements

# Sandboxed Execution Engine (DuckDB & PostgreSQL)
DUCKDB_DATABASE_PATH=:memory:
DUCKDB_MEMORY_LIMIT_MB=512
DUCKDB_TIMEOUT_SECONDS=2.0

# Optional PostgreSQL NDAP Mirror
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ndap_mirror
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
