# ==============================================================================
# IndicSQL Configuration Template  (copy to .env; .env is gitignored)
# ==============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
# Optional: require this value in the X-API-Key header on every request
INDICSQL_API_KEY=

# --- SQL generation backend --------------------------------------------------
# Hosted inference (OpenAI-compatible /chat/completions). If all of BASE_URL and
# MODEL are set, it is used for neural SQL generation; otherwise local Ollama.
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=

# Local fallback (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Voice / Indic services (Sarvam) -----------------------------------------
SARVAM_API_KEY=
SARVAM_MODEL_ENDPOINT=https://api.sarvam.ai/v1

# --- Other OpenAI-compatible server (optional) -------------------------------
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=

# --- Hugging Face (model / LoRA downloads) -----------------------------------
HF_TOKEN=

# --- Embeddings & vector store -----------------------------------------------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ndap_schema_elements

# --- DuckDB sandbox ----------------------------------------------------------
DUCKDB_DATABASE_PATH=:memory:
DUCKDB_MEMORY_LIMIT_MB=512
DUCKDB_TIMEOUT_SECONDS=2.0

# --- Optional PostgreSQL NDAP mirror -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ndap_mirror
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Open Government Data (data.gov.in) --------------------------------------
DATA_GOV_IN_API_KEY=
